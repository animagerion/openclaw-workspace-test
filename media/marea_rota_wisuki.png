.modal.guider_content { margin: auto; z-index: 9999999; }

.modal.guider_content .btn { text-decoration: none; }

#guider_overlay { background-color: rgb(0, 0, 0); width: 100%; height: 100%; position: fixed; top: 0px; left: 0px; opacity: 0.5; z-index: 10; }

.guider_highlight { position: relative !important; z-index: 2001 !important; }

.navbar.guider_highlight { position: fixed !important; }

.navbar.guider_highlight #spot-search { background: rgb(255, 255, 255); }

.quick-tour-link { cursor: pointer; position: absolute; top: 170px; right: 10px; z-index: 1000; text-align: center; width: 120px; height: 35px; line-height: 35px; border-radius: 5px; background: rgba(189, 6, 16, 0.5); }

.quick-tour-link a { color: rgb(255, 255, 255); text-decoration: none; }

.quick-tour-link a:hover { color: rgb(255, 255, 255); text-decoration: none; }

.quick-tour-link i { cursor: pointer; }

.no-rgba .quick-tour-link { background: url("img/redalpha50.png") repeat; }

.jspContainer { overflow: hidden; position: relative; }

.jspPane { position: absolute; }

.jspVerticalBar { position: absolute; top: 0px; right: 0px; width: 12px; height: 100%; display: none; }

.jspHorizontalBar { position: absolute; bottom: 0px; left: 0px; width: 100%; height: 12px; }

.jspVerticalBar *, .jspHorizontalBar * { margin: 0px; padding: 0px; }

.jspCap { display: none; }

.jspHorizontalBar .jspCap { float: left; }

.jspTrack { background: -webkit-linear-gradient(top, rgb(204, 204, 204), rgb(237, 237, 237)) repeat-x rgb(237, 237, 237); position: relative; border-radius: 8px; }

.jspDrag { background: -webkit-linear-gradient(top, rgb(221, 221, 221), rgb(175, 175, 175)) repeat-x rgb(175, 175, 175); position: relative; top: 0px; left: 0px; cursor: pointer; border-radius: 8px; }

.jspHorizontalBar .jspTrack, .jspHorizontalBar .jspDrag { float: left; height: 100%; }

.jspArrow { text-indent: -20000px; display: block; cursor: pointer; background: url("img/trackarrows.png") no-repeat transparent; }

.jspArrowLeft { background-position: 0px -24px; }

.jspArrowRight { background-position: 0px -36px; }

.jspArrowLeft.jspDisabled { background-position: 0px 0px; }

.jspArrowRight.jspDisabled { background-position: 0px -12px; }

.jspArrow.jspDisabled { cursor: default; }

.jspVerticalBar .jspArrow { height: 16px; }

.jspHorizontalBar .jspArrow { width: 16px; float: left; height: 100%; }

.jspVerticalBar .jspArrow:focus { outline: 0px; }

.jspCorner { background: rgb(238, 238, 244); float: left; height: 100%; }

* html .jspCorner { margin: 0px -3px 0px 0px; }

.avatar { border-radius: 100px; }

.navbar img.avatar { margin-right: 6px; margin-top: -1px; float: none; height: auto; vertical-align: middle; border: 0px; }

textarea[readonly] { background-color: rgb(255, 255, 255); cursor: text; }

legend + .control-group { margin-top: 0px; }

textarea.wide { width: 98.4%; }

.dropup .dropdown { bottom: 100%; top: 0px; }

.dropup .dropdown-menu { border-radius: 5px 5px 0px 0px; }

.collapse { transition: none; }

.touch .navbar-static-top { position: static; }

.touch .left-content #alert-type-selector { position: absolute; }

.page-wsk-custom-register .page-header { text-align: center; }

.wsk-custom-register { width: 300px; margin-left: auto; margin-right: auto; padding-bottom: 15px; }

.wsk-custom-register .field { margin-bottom: 18px; }

.wsk-custom-register .help-block { margin-top: 2px; color: rgb(117, 117, 132); }

.wsk-custom-register label { margin-bottom: 2px; }

.wsk-custom-register input[type="text"], .wsk-custom-register input[type="password"] { margin-bottom: 0px; }

.wsk-custom-register .sep { margin-top: 20px; padding: 10px 0px; text-align: center; }

.wsk-custom-register .sep strong { padding: 0px 20px; background-color: rgb(255, 255, 255); }

.wsk-custom-register .sep hr { margin: 0px 0px -10px; }

.wsk-custom-register .social-buttons-header { display: none; }

.wsk-custom-register .social-buttons { width: 100%; display: table; table-layout: fixed; border-spacing: 10px; background-color: rgb(236, 235, 238); border-radius: 4px; padding-bottom: 0px; margin-bottom: 0px; border-bottom: 0px; }

.wsk-custom-register .wsl_connect_with_provider { display: table-cell; }

#modal-label { font-size: 24.5px; line-height: 30px; font-weight: 400; }

.btn-block { display: block; padding-left: 0px; padding-right: 0px; width: 100%; font-size: 14px; padding-bottom: 7px; }

.widget-search-form { padding-top: 15px; }

.widget-search-form label { font-weight: 700; font-size: 16px; padding: 3px 10px 0px 0px; }

.widget-search-form .input-large { width: 400px; font-size: 16px; height: 26px; vertical-align: baseline; }

.redeem-box { background-color: rgb(245, 245, 245); border-radius: 4px; padding: 20px 0px; }

.redeem-box .field, .redeem-box label { max-width: 360px; margin-left: auto; margin-right: auto; }

.redeem-box label { font-weight: 700; font-size: 16px; }

.redeem-box .field { zoom: 1; }

.redeem-box .field::before, .redeem-box .field::after { display: table; content: " "; }

.redeem-box .field::after { clear: both; }

.redeem-box .field input, .redeem-box .field .btn { float: left; }

.redeem-box .field input[type="text"] { height: 27px; margin-right: 10px; }

.redeem-box .control-group { margin-bottom: 0px; }

@media only screen and (max-width: 1220px) {
  .tab-view-selector .label { display: none; }
}

@media only screen and (max-width: 1024px) {
  .tab-view-selector .label { display: none; }
  .selector-viewtype .btn span { clip: rect(1px, 1px, 1px, 1px); position: absolute !important; }
}

@media only screen and (max-width: 1160px) {
  .tab-view-selector .label { display: none; }
  .tab-view-selector.day-selector { padding-left: 20%; }
}
