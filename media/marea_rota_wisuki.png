.fb_dialog.fb_dialog_mobile.loading.centered .fb_dialog_content { background: none; }

.loading.centered #fb_dialog_loader_close { clear: both; color: rgb(255, 255, 255); display: block; font-size: 18px; padding-top: 20px; }

