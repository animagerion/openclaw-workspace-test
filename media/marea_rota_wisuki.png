.ui-menu .ui-menu-item a { line-height: 2.3; }

.ui-menu .ui-menu-item a.ui-corner-all { border-radius: 0px; }

.ui-menu .ui-menu-item:first-child a.ui-corner-all { border-radius: 4px 4px 0px 0px; }

